      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 15, "drawStyle": "line", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(mongodb_ss_network_bytesIn[5m])", "refId": "A", "legendFormat": "in" },
        { "expr": "rate(mongodb_ss_network_bytesOut[5m])", "refId": "B", "legendFormat": "out" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "MongoDB Resident Memory",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
